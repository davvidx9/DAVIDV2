# SIP trunk (your client's published number — no spoof)
SIP_USERNAME=
SIP_PASSWORD=
SIP_DOMAIN=sip.example.com
SIP_PORT=5060
SIP_TRANSPORT=udp
SIP_ENDPOINT=trunk
CALLER_ID_NUMBER=+12025551234
CALLER_ID_NAME=MyCompany

# Asterisk ARI (must match asterisk/ari.conf)
ARI_URL=http://asterisk:8088/ari
ARI_USERNAME=ivr
ARI_PASSWORD=ivr_secret
ARI_APP=ivr-platform

# MongoDB
MONGO_URI=mongodb://mongodb:27017
MONGO_DB=ivr_platform

# Telegram
TELEGRAM_BOT_TOKEN=

# Optional public URL (health checks only; events use ARI WebSocket)
NGROK_URL=https://your-subdomain.ngrok-free.app

# Admin Telegram user IDs (comma-separated) for /genkey
ADMINS=

# TTS
TTS_ENGINE=gtts
DEFAULT_TTS_LANG=en

# Paths (Docker defaults)
SOUNDS_DIR=/app/sounds
RECORDINGS_DIR=/app/recordings
